{
  "name": "mapos-mobile",
  "private": true,
  "version": "1.3.1",
  "type": "module",
  "description": "Aplicativo mobile (PWA) do MAPOS — consome a API v1 do sistema",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "validate": "npm run build && node ../teste/run.mjs",
    "test:tecnico": "node ../teste/run-tecnico.mjs",
    "test:colaborador": "node ../teste/run-colaborador.mjs",
    "sync:android": "npm run build && cap sync android",
    "icone": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/gerar-icone-app.ps1",
    "apk": "npm run icone && npm run sync:android && cd android && .\\gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "7.4.3",
    "@capacitor/core": "7.4.3",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "7.4.3",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}

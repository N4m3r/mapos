<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# PHP2Shell (CVE-2026-109619): mitigacao parcial em hospedagens com mod_php
<IfModule mod_php.c>
    php_flag session.upload_progress.enabled off
</IfModule>

# Cabecalhos de seguranca (so se o servidor tiver mod_headers)
# SAMEORIGIN: as telas de e-mail usam iframe do proprio sistema para o preview
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Compressao de respostas de texto (so se o servidor tiver mod_deflate)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript text/javascript application/json application/xml image/svg+xml
</IfModule>

# Cache de imagens e fontes no navegador. CSS/JS ficam de fora de proposito:
# nem todos tem ?v= no link, e cache longo serviria versao antiga apos atualizar.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/gif "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/x-icon "access plus 30 days"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
</IfModule>

RewriteEngine On
# Pastas internas nunca sao servidas direto (mesma regra do nginx do docker):
# logs, backups, certificados e codigo ficam em application/.
RewriteRule ^(application|system|vendor|docker)(/|$) - [F,L]
RewriteCond %{HTTP:Authorization} ^(.+)$
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
